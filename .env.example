SENTINEL_DATABASE_URL=sqlite:///data/sentinelflow-demo.sqlite3
SENTINEL_PUBLIC_DEMO=false
SENTINEL_API_TOKEN=
SENTINEL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SENTINEL_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
SENTINEL_MAX_UPLOAD_BYTES=5242880
SENTINEL_MAX_EVENTS=10000
SENTINEL_BACKEND_PORT=8765
SENTINEL_FRONTEND_PORT=5173

# Empty uses /api for the development proxy or combined local app.
# On Vercel set this to your Render HTTPS origin (no credentials).
VITE_API_BASE_URL=

# Used only by scripts/serve.py; make dev keeps SENTINEL_BACKEND_PORT.
PORT=10000

# Optional private integrations; all external activity is disabled by default.
SENTINEL_ENABLED=false
GRAPH_ENABLED=false
WINDOWS_COLLECTOR_ENABLED=false
NOTIFICATIONS_ENABLED=false
SENTINEL_INTEGRATION_WORKER=true
SENTINEL_INTEGRATION_LOCAL_TEST=false
SENTINEL_WEBHOOK_ALLOWED_NETWORKS=
# HTTPS application URL used in outbound investigation links; empty means no link.
PUBLIC_BASE_URL=
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_WORKSPACE_ID=
# Set SENTINEL_CLIENT_SECRET only in the private server environment.
SENTINEL_POLL_INTERVAL_SECONDS=60
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Set GRAPH_CLIENT_SECRET only in the private server environment.
GRAPH_POLL_INTERVAL_SECONDS=60
# Add your own SENTINEL_INTEGRATION_* secret variables only to an untracked
# server environment. Management APIs store their names, never their values.
